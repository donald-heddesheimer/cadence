BasedOnStyle: Google
Language: Cpp
Standard: c++17

# Four spaces, no tabs.
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Preserve manually chosen line breaks.
ColumnLimit: 0
ReflowComments: false

# Namespace indentation is maintained manually because nested `detail`
# namespaces intentionally remain aligned with their opening declaration.
NamespaceIndentation: All

DerivePointerAlignment: false
PointerAlignment: Left
# Keep small forwarding functions on one line.
AllowShortFunctionsOnASingleLine: All
IndentPPDirectives: None
